<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] [node=%X{bikesched.nodeId:-} job=%X{bikesched.jobId:-} type=%X{bikesched.jobType:-} step=%X{bikesched.stepName:-}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="bikesched" level="DEBUG"/>
    <logger name="org.testcontainers" level="WARN"/>
    <logger name="tc" level="WARN"/>
    <logger name="com.github.dockerjava" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
