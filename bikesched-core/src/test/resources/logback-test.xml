<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Logging context keys are only printed when set: each " key=value" pair is dropped by
                 %replace if its value is empty (e.g. no job id on the poller, no step outside steps). -->
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread]%replace( node=%X{bikesched.nodeId}){' node=$', ''}%replace( job=%X{bikesched.jobId}){' job=$', ''}%replace( type=%X{bikesched.jobType}){' type=$', ''}%replace( step=%X{bikesched.stepName}){' step=$', ''} %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="bikesched" level="DEBUG"/>
    <logger name="org.testcontainers" level="WARN"/>
    <logger name="tc" level="WARN"/>
    <logger name="com.github.dockerjava" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
