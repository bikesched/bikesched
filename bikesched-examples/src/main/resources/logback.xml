<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <!-- Job id and step name from bikesched's logging context, only when set. -->
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{0}%replace( job=%X{bikesched.jobId}){' job=$', ''}%replace( step=%X{bikesched.stepName}){' step=$', ''} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- DEBUG shows every processed job and step. -->
  <!-- bikesched and the examples (org.bikesched.examples) at INFO. -->
  <logger name="org.bikesched" level="INFO"/>

  <root level="WARN">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
